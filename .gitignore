# ============================================================
# CEST Studio —— 只把「代码」入库，运行时/工具/日志一概不进
# ============================================================

# 便携运行时（约 495 MB 的 Python + 依赖）
#   → 不进 Git；需要「下载即用」的人请到 Releases 下载完整免安装包
/runtime/

# 开发工具 / 备份 / 测试记录 / 交接文档（含便携 git 本体）
/_dev/

# 运行日志（每次启动自动生成）
**/logs/
*.log

# Python 缓存
**/__pycache__/
*.py[cod]

# 本机设置（含绝对路径；文件缺失时程序会自动生成默认值）
CEST_Studio/config/settings.json

# 产物 / 覆盖备份
*.bak
*.bak_*

# 操作系统 / 编辑器杂物
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
